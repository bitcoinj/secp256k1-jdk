<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.bitcoinj.secp</groupId>
        <artifactId>secp256k1-jdk</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>secp-integration-test</artifactId>
    <packaging>jar</packaging>

    <name>secp-integration-test</name>
    <description>Secp256k1 Integration Tests</description>

    <properties>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.bitcoinj.secp</groupId>
            <artifactId>secp-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bitcoinj.secp</groupId>
            <artifactId>secp-bouncy</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bitcoinj.secp</groupId>
            <artifactId>secp-ffm</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.bitcoinj.secp</groupId>
            <artifactId>secp-graalvm</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.opencsv</groupId>
            <artifactId>opencsv</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Djava.library.path=${env.LIBSECP_DIR} --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>Secp256k1 Integration Tests</Implementation-Title>
                            <Automatic-Module-Name>org.bitcoinj.secp.integration</Automatic-Module-Name>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>native-test</id>
            <build><plugins>
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>${maven-native-plugin.version}</version>
                    <extensions>true</extensions>
                    <executions>
                        <execution>
                            <id>test-native</id>
                            <goals><goal>test</goal></goals>
                            <phase>test</phase>
                        </execution>
                    </executions>
                    <configuration>
                        <buildArgs>
                            <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                            <buildArg>--features=org.bitcoinj.secp.graalvmffm.ForeignRegistrationFeature</buildArg>
                            <buildArg>-H:+ForeignAPISupport</buildArg>
                            <buildArg>-H:+SharedArenaSupport</buildArg>
                            <buildArg>-H:-CheckToolchain</buildArg>
                            <buildArg>--initialize-at-build-time=org.junit.platform.commons.logging</buildArg>
                            <buildArg>--initialize-at-build-time=org.junit.platform.engine.UniqueId</buildArg>
                        </buildArgs>
                        <runtimeArgs>
                            <runtimeArg>-Djava.library.path=${env.LIBSECP_DIR}</runtimeArg>
                        </runtimeArgs>
                    </configuration>
                </plugin>
            </plugins></build>
        </profile>
    </profiles>
</project>
